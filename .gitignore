# Python bytecode
__pycache__/
*.pyc

# Workspace (dry-run) runtime state — kept separate from the committed
# production seed so dev's simulated "seen" items never seed the Deployment.
*.local.json

# Runtime watchlist state (contains Discord user IDs; never commit it).
watchlists.db
watchlists.db-shm
watchlists.db-wal
sold_comps_cache*.json

# Live repeat-limit state (posted alerts per product, last 24h). Runtime only.
product_alerts.json
